# Copiar a .env y completar (no subir .env a git).
# Railway: Project → Postgres → Variables → copiar DATABASE_URL

DATABASE_URL=

# Si conectás a Railway desde tu PC, suele hacer falta TLS:
DATABASE_SSL=true

# Opcional: exigir certificado (en Railway normalmente va en false / omitido)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Sin DATABASE_URL (PostgreSQL local):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=agustina
# DB_USER=postgres
# DB_PASSWORD=postgres

# NODE_ENV=development
# SEQUELIZE_LOGGING=true
