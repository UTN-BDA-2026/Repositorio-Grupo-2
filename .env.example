# =============================================================================
# 1) Copiar este archivo a la raíz del repo como ".env" (no subir .env a git).
#    PowerShell:  Copy-Item .env.example .env
#    cmd:        copy .env.example .env
#    bash:       cp .env.example .env
#
# 2) Pegar la DATABASE_URL que compartió el docente / Railway (Postgres).
#
# 3) Si conectás a Railway desde Windows y falla la conexión o TLS, agregá:
#    DATABASE_SSL=true
# =============================================================================

# Obligatorio con Railway (valor real lo pega el grupo; no commitear):
DATABASE_URL=

# Recomendado al conectar desde Windows (o cualquier cliente) a Railway:
DATABASE_SSL=true

# Solo si tu entorno exige validar el certificado CA (suele NO hacer falta):
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Alternativa: Postgres local (sin DATABASE_URL o con DATABASE_URL vacío) ---
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=agustina
# DB_USER=postgres
# DB_PASSWORD=postgres

# NODE_ENV=development
# SEQUELIZE_LOGGING=true

# Cantidad de filas del seeder de experimento (default 15000 si se omite). Ej.: 50000
# SEED_PRODUCT_COUNT=15000
