{
  "name": "agustina-db",
  "private": true,
  "version": "1.0.0",
  "description": "Esquema PostgreSQL + Sequelize (migraciones/modelos) para el proyecto BD Avanzada",
  "scripts": {
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:setup": "sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "informe:c": "node scripts/run-explain-c.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  }
}
