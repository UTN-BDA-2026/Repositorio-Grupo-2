{
  "name": "agustina-db",
  "private": true,
  "version": "1.0.0",
  "description": "Esquema PostgreSQL + Sequelize (migraciones/modelos) para el proyecto BD Avanzada",
  "scripts": {
    "dev": "node server.js",
    "export:products": "node scripts/export-demo-products.js",
    "db:import-demo": "node scripts/import-demo-products.js",
    "db:import-demo:undo": "node scripts/import-demo-products.js --undo",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:setup": "sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:backup": "node scripts/db-backup-cli.js create",
    "db:backup:list": "node scripts/db-backup-cli.js list",
    "db:backup:restore": "node scripts/db-backup-cli.js restore",
    "db:backup:delete": "node scripts/db-backup-cli.js delete",
    "db:backup:validate": "node scripts/db-backup-cli.js validate",
    "db:backup:prune": "node scripts/db-backup-cli.js prune",
    "informe:c": "node scripts/run-explain-c.js",
    "informe:de": "node scripts/run-informe-de.js",
    "test": "node --test tests/**/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "sequelize-cli": "^6.6.2"
  }
}
